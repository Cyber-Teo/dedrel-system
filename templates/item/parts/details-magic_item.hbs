<div class="form-fields-grid">
    <div class="section-header">
        {{localize "DEDREL.ItemSheet.MagicItemPayload"}}
    </div>
    <div class="form-group stacked" style="grid-column: 1 / -1;">
        <label>{{localize "DEDREL.ItemSheet.EffectDescription"}}</label>
        <input type="text" name="system.effect_description" value="{{system.effect_description}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemFields.FormulaHeal"}}</label>
        <input type="text" name="system.formula_heal" value="{{system.formula_heal}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.OnUseMacro"}}</label>
        <input type="text" name="system.on_use_macro" value="{{system.on_use_macro}}"/>
    </div>

    <div class="section-header">
        {{localize "DEDREL.ItemSheet.BoundSpell"}}
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.SpellId"}}</label>
        <input type="text" name="system.spell_id" value="{{system.spell_id}}" placeholder="Item id"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.SpellKey"}}</label>
        <input type="text" name="system.spell_key" value="{{system.spell_key}}" placeholder="system.key"/>
    </div>

    <div class="section-header">
        {{localize "DEDREL.ItemSheet.Uses"}}
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.Current"}}</label>
        <input type="text" name="system.uses_value" value="{{system.uses_value}}" data-dtype="Number"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.Maximum"}}</label>
        <input type="text" name="system.uses_max" value="{{system.uses_max}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.Recovery"}}</label>
        <select name="system.uses_per">
            <option value="" {{#if (eq system.uses_per "")}}selected{{/if}}>{{localize "DEDREL.ItemSheet.RecoveryNone"}}</option>
            <option value="short_rest" {{#if (eq system.uses_per "short_rest")}}selected{{/if}}>{{localize "DEDREL.ItemSheet.RecoveryShortRest"}}</option>
            <option value="long_rest" {{#if (eq system.uses_per "long_rest")}}selected{{/if}}>{{localize "DEDREL.ItemSheet.RecoveryLongRest"}}</option>
            <option value="day" {{#if (eq system.uses_per "day")}}selected{{/if}}>{{localize "DEDREL.ItemSheet.RecoveryDay"}}</option>
        </select>
    </div>

    <div class="section-header">
        {{localize "DEDREL.ItemSheet.Requirements"}}
    </div>
    <div class="form-group stacked" style="grid-column: 1 / -1;">
        <label>{{localize "DEDREL.ItemSheet.ReqText"}}</label>
        <input type="text" name="system.requirements.text" value="{{system.requirements.text}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.ReqAttributeKey"}}</label>
        <input type="text" name="system.requirements.attribute.key" value="{{system.requirements.attribute.key}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.ReqAttributeRank"}}</label>
        <input type="text" name="system.requirements.attribute.rank" value="{{system.requirements.attribute.rank}}" data-dtype="Number"/>
    </div>
</div>
