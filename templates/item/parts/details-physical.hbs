<div class="form-fields-grid">
    <div class="section-header">
        {{localize "DEDREL.ItemSheet.PhysicalProperties"}}
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.Rarity"}}</label>
        <select name="system.rarity" style="width: 100%;">
            {{selectOptions rarityOptions selected=system.rarity}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.Weight"}}</label>
        <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.BasePrice"}}</label>
        <input type="text" name="system.base_price" value="{{system.base_price}}" data-dtype="Number"/>
    </div>
    {{#if hasStackable}}
    <div class="form-group">
        <label class="checkbox"><input type="checkbox" name="system.stackable" {{checked system.stackable}}/> {{localize "DEDREL.ItemSheet.Stackable"}}</label>
    </div>
    {{/if}}
</div>
