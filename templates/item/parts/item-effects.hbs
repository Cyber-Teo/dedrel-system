<div class="tab effects {{tabs.effects.cssClass}}" data-group="primary" data-tab="effects">
<div class="effects-header flexrow">
    <h3 style="flex: 1;">{{localize "DEDREL.ItemSheet.Effects"}}</h3>
    <a class="effect-control" data-action="addEffectFromLibrary" title="{{localize "DEDREL.EffectLib.PickTitle"}}" style="flex: 0 0 auto; padding: 5px; margin-right: 5px; background: rgba(0,0,0,0.1); border-radius: 4px;"><i class="fas fa-book"></i> {{localize "DEDREL.EffectLib.FromLibrary"}}</a>
    <a class="effect-control" data-action="addEffect" title="{{localize "DEDREL.ItemSheet.AddEffect"}}" style="flex: 0 0 auto; padding: 5px; background: rgba(0,0,0,0.1); border-radius: 4px;"><i class="fas fa-plus"></i> {{localize "DEDREL.ItemSheet.AddEffect"}}</a>
</div>
<div class="effects-list">
    {{#each effectRows as |row|}}
    {{#with row.effect as |effect|}}
    <div class="effect-item flexrow" data-effect-id="{{effect.id}}" style="padding: 5px; border-bottom: 1px solid var(--color-border-dark); align-items: center;">
        <img src="{{effect.img}}" width="24" height="24" style="margin-right: 10px; border: none;"/>
        <h4 style="flex: 1; margin: 0;">{{effect.name}}</h4>
        <div class="effect-controls">
            <a class="effect-control" data-action="toggleEffectSelf" title="{{localize "DEDREL.ItemSheet.EffectSelfHint"}}" {{#if (eq effect.flags.dedrel.applyTo "self")}}style="color: var(--color-text-hyperlink, #4a90d9);"{{else}}style="opacity: 0.4;"{{/if}}><i class="fas fa-user"></i></a>
            <a class="effect-control" data-action="toggleEffectAuraPayload" title="{{localize "DEDREL.ItemSheet.EffectAuraPayloadHint"}}" {{#if (eq effect.flags.dedrel.applyTo "aura")}}style="color: var(--color-text-hyperlink, #4a90d9);"{{else}}style="opacity: 0.4;"{{/if}}><i class="fas fa-bullseye"></i></a>
            <a class="effect-control" data-action="configureEffectAura" title="{{localize "DEDREL.ItemSheet.EffectAuraConfigHint"}}" {{#if effect.flags.dedrel.aura}}style="color: var(--color-text-hyperlink, #4a90d9);"{{else}}style="opacity: 0.4;"{{/if}}><i class="fas fa-circle-dot"></i></a>
            <a class="effect-control" data-action="configureEffectLight" title="{{localize "DEDREL.ItemSheet.EffectLightConfigHint"}}" {{#if row.hasLight}}style="color: var(--color-text-hyperlink, #4a90d9);"{{else}}style="opacity: 0.4;"{{/if}}><i class="fas fa-lightbulb"></i></a>
            <a class="effect-control" data-action="editEffect" title="{{localize "DEDREL.ItemSheet.Edit"}}"><i class="fas fa-edit"></i></a>
            <a class="effect-control" data-action="deleteEffect" title="{{localize "DEDREL.ItemSheet.Delete"}}"><i class="fas fa-trash"></i></a>
        </div>
    </div>
    {{/with}}
    {{else}}
    <p class="hint">{{localize "DEDREL.ItemSheet.NoEffects"}}</p>
    {{/each}}
</div>
</div>
