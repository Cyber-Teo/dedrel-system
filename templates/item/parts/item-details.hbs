<div class="tab details {{tabs.details.cssClass}}" data-group="primary" data-tab="details">
    {{#unless (eq item.type "creature_type")}}
    <div class="form-group" style="padding: 10px; background: rgba(0,0,0,0.2); border-bottom: 1px solid var(--color-border); margin-bottom: 10px;">
        <label style="font-weight: bold; width: 100px;">{{localize "DEDREL.ItemFields.SystemKey"}}</label>
        <input type="text" name="system.key" value="{{system.key}}" placeholder="unique_item_id" style="flex: 1;"/>
    </div>
    {{/unless}}
    {{#if (eq item.type "creature_type")}}
        {{> "systems/dedrel/templates/item/parts/details-creature_type.hbs"}}
    {{/if}}
    {{#if isPhysical}}
        {{> "systems/dedrel/templates/item/parts/details-physical.hbs"}}
    {{/if}}
    {{#if hasEquipSlot}}
        {{> "systems/dedrel/templates/item/parts/details-equip-slot.hbs"}}
    {{/if}}
    {{#if (eq item.type "loot")}}
    <div class="form-group" style="padding: 10px; border-bottom: 1px solid var(--color-border); margin-bottom: 10px;">
        <label>{{localize "DEDREL.ItemFields.FormulaHeal"}}</label>
        <input type="text" name="system.formula_heal" value="{{system.formula_heal}}"/>
    </div>
    {{/if}}
    {{#if (eq item.type "potion")}}
        {{> "systems/dedrel/templates/item/parts/details-potion.hbs"}}
    {{else if (eq item.type "scroll")}}
        {{> "systems/dedrel/templates/item/parts/details-scroll.hbs"}}
    {{else if (eq item.type "magic_item")}}
        {{> "systems/dedrel/templates/item/parts/details-magic_item.hbs"}}
    {{else if (eq item.type "craft_material")}}
        {{> "systems/dedrel/templates/item/parts/details-craft_material.hbs"}}
    {{else if (eq item.type "quest_item")}}
        {{> "systems/dedrel/templates/item/parts/details-quest_item.hbs"}}
    {{else if (eq item.type "currency")}}
        {{> "systems/dedrel/templates/item/parts/details-currency.hbs"}}
    {{else if (eq item.type "service")}}
        {{> "systems/dedrel/templates/item/parts/details-service.hbs"}}
    {{else if (eq item.type "ammunition")}}
        {{> "systems/dedrel/templates/item/parts/details-ammunition.hbs"}}
    {{/if}}
    {{#if (eq item.type "maneuver")}}
        {{> "systems/dedrel/templates/item/parts/details-maneuver.hbs"}}
    {{else if (eq item.type "spell")}}
        {{> "systems/dedrel/templates/item/parts/details-spell.hbs"}}
    {{else if (eq item.type "condition")}}
        {{> "systems/dedrel/templates/item/parts/details-condition.hbs"}}
    {{/if}}

    {{#if (or (eq item.type "talent") (eq item.type "mutation"))}}
        {{> "systems/dedrel/templates/item/parts/details-talent.hbs"}}
    {{/if}}

    {{#if (eq item.type "armor")}}
        {{> "systems/dedrel/templates/item/parts/details-armor.hbs"}}
    {{/if}}

    {{#if (eq item.type "weapon")}}
        {{> "systems/dedrel/templates/item/parts/details-weapon.hbs"}}
    {{/if}}

    {{#if (eq item.type "exp")}}
        {{> "systems/dedrel/templates/item/parts/details-exp.hbs"}}
    {{/if}}
</div>
