<div class="form-fields-grid crafting-block">
    <div class="section-header">
        {{localize "DEDREL.Crafting.SectionTitle"}}
    </div>
    <div class="form-group">
        <label class="checkbox"><input type="checkbox" name="system.crafting.craftable" {{checked system.crafting.craftable}}/> {{localize "DEDREL.Crafting.Craftable"}}</label>
    </div>
    {{#if system.crafting.craftable}}
    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.Discipline"}}</label>
        <select name="system.crafting.discipline" style="width: 100%;">
            {{selectOptions craftDisciplineOptions selected=system.crafting.discipline}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.OutputQuantity"}}</label>
        <input type="number" name="system.crafting.output_quantity" value="{{system.crafting.output_quantity}}" min="1" step="1"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.TimeOverride"}}</label>
        <input type="number" name="system.crafting.time_override" value="{{system.crafting.time_override}}" min="0" step="1"/>
    </div>

    <div class="section-header">
        {{localize "DEDREL.Crafting.Ingredients"}}
    </div>
    <div class="crafting-drop-zone" data-drop="craft-ingredient"
         style="border: 1px dashed var(--color-border); border-radius: 4px; padding: 8px; text-align: center; opacity: 0.8; margin-bottom: 6px;">
        <i class="fa-solid fa-flask"></i> {{localize "DEDREL.Crafting.DropHint"}}
    </div>
    {{#each system.crafting.ingredients as |ing idx|}}
    <div class="form-group">
        <label style="flex: 2;" title="{{ing.uuid}}">{{#if ing.name}}{{ing.name}}{{else}}—{{/if}}</label>
        <input type="number" class="craft-ingredient-amount" data-ingredient-index="{{idx}}" value="{{ing.amount}}" min="0" step="any" style="flex: 1;"/>
        <a data-action="deleteCraftIngredient" data-ingredient-index="{{idx}}" title="{{localize 'DEDREL.Crafting.DeleteIngredient'}}" style="flex: 0; padding: 0 6px;"><i class="fa-solid fa-trash"></i></a>
    </div>
    {{/each}}

    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.MarkupPct"}}</label>
        <input type="number" name="system.crafting.markup_pct" value="{{system.crafting.markup_pct}}" min="0" step="any"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.CostPrice"}}</label>
        <input type="number" value="{{system.crafting.cost_price}}" disabled/>
    </div>
    <div class="form-group">
        <button type="button" data-action="recomputeCraftPrice" style="width: 100%;">
            <i class="fa-solid fa-calculator"></i> {{localize "DEDREL.Crafting.Recompute"}}
        </button>
    </div>
    <p class="hint" style="margin: 4px 0 0;">{{localize "DEDREL.Crafting.RecomputeHint"}}</p>
    {{/if}}
</div>
