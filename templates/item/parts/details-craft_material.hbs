<div class="form-fields-grid">
    <div class="section-header">
        {{localize "DEDREL.ItemSheet.CraftMaterial"}}
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.MaterialClass"}}</label>
        <select name="system.material_class" style="width: 100%;">
            {{selectOptions materialClassOptions selected=system.material_class}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.MaterialType"}}</label>
        <input type="text" name="system.material_type" value="{{system.material_type}}" placeholder="ore, herb, wood, skin, magical_essence"/>
    </div>

    {{! Свободный текст на всю ширину: место под длинные описания свойств }}
    <div style="grid-column: 1 / -1;">
        <label style="display: block; font-weight: bold; margin-bottom: 2px;">{{localize "DEDREL.Crafting.SpecialRules"}}</label>
        <input type="text" name="system.special_rules" value="{{system.special_rules}}" placeholder="{{localize 'DEDREL.Crafting.SpecialRulesPlaceholder'}}" style="width: 100%;"/>
    </div>

    {{#unless isProcessedMaterial}}
    <div class="form-group" style="grid-column: 1 / -1;">
        <label>{{localize "DEDREL.Crafting.ApplicableTo"}}</label>
        <div class="form-fields" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.weapon" {{checked system.applicable_to.weapon}}/> {{localize "DEDREL.Crafting.ApplicableWeapon"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.armor" {{checked system.applicable_to.armor}}/> {{localize "DEDREL.Crafting.ApplicableArmor"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.shield" {{checked system.applicable_to.shield}}/> {{localize "DEDREL.Crafting.ApplicableShield"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.jewelry" {{checked system.applicable_to.jewelry}}/> {{localize "DEDREL.Crafting.ApplicableJewelry"}}</label>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.WeightClass"}}</label>
        <input type="text" name="system.weight_class" value="{{system.weight_class}}" placeholder="normal, heavy, light"/>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.Crafting.Slots"}}</label>
        <select class="material-slots-field" style="width: 100%;">
            {{selectOptions materialSlotOptions selected=materialSlot}}
        </select>
    </div>
    <p class="hint" style="grid-column: 1 / -1; margin: 0;">{{localize "DEDREL.Crafting.SlotsHint"}}</p>

    <div class="section-header">
        {{localize "DEDREL.Crafting.Signature"}}
    </div>
    <div style="grid-column: 1 / -1;">
        <label style="display: block; font-weight: bold; margin-bottom: 2px;">{{localize "DEDREL.Crafting.SignatureArmor"}}</label>
        <input type="text" name="system.signature.armor" value="{{system.signature.armor}}" placeholder="{{localize 'DEDREL.Crafting.SignatureArmorPlaceholder'}}" style="width: 100%;"/>
    </div>
    <div style="grid-column: 1 / -1;">
        <label style="display: block; font-weight: bold; margin-bottom: 2px;">{{localize "DEDREL.Crafting.SignatureWeapon"}}</label>
        <input type="text" name="system.signature.weapon" value="{{system.signature.weapon}}" placeholder="{{localize 'DEDREL.Crafting.SignatureWeaponPlaceholder'}}" style="width: 100%;"/>
    </div>
    <div style="grid-column: 1 / -1;">
        <label style="display: block; font-weight: bold; margin-bottom: 2px;">{{localize "DEDREL.Crafting.SignatureMagic"}}</label>
        <input type="text" name="system.signature.magic" value="{{system.signature.magic}}" placeholder="{{localize 'DEDREL.Crafting.SignatureMagicPlaceholder'}}" style="width: 100%;"/>
    </div>
    <p class="hint" style="grid-column: 1 / -1; margin: 4px 0 0;">{{localize "DEDREL.Crafting.SignatureHint"}}</p>
    {{/unless}}
</div>
