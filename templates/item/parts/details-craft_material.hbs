<div class="form-fields-grid">
    <div class="section-header">
        {{localize "DEDREL.ItemSheet.CraftMaterial"}}
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.MaterialClass"}}</label>
        <select name="system.material_class" style="width: 100%;">
            {{selectOptions materialClassOptions selected=system.material_class}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "DEDREL.ItemSheet.MaterialType"}}</label>
        <input type="text" name="system.material_type" value="{{system.material_type}}" placeholder="ore, herb, wood, skin, magical_essence"/>
    </div>

    {{! Свободный текст на всю ширину: место под длинные описания свойств }}
    <div style="grid-column: 1 / -1;">
        <label style="display: block; font-weight: bold; margin-bottom: 2px;">{{localize "DEDREL.Crafting.SpecialRules"}}</label>
        <input type="text" name="system.special_rules" value="{{system.special_rules}}" placeholder="{{localize 'DEDREL.Crafting.SpecialRulesPlaceholder'}}" style="width: 100%;"/>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
        <label>{{localize "DEDREL.Crafting.ApplicableTo"}}</label>
        <div class="form-fields" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.weapon" {{checked system.applicable_to.weapon}}/> {{localize "DEDREL.Crafting.ApplicableWeapon"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.armor" {{checked system.applicable_to.armor}}/> {{localize "DEDREL.Crafting.ApplicableArmor"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.shield" {{checked system.applicable_to.shield}}/> {{localize "DEDREL.Crafting.ApplicableShield"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.applicable_to.jewelry" {{checked system.applicable_to.jewelry}}/> {{localize "DEDREL.Crafting.ApplicableJewelry"}}</label>
        </div>
    </div>

    <div class="section-header">
        {{localize "DEDREL.Crafting.Grants"}}
        <a data-action="addMaterialGrant" title="{{localize 'DEDREL.Crafting.AddGrant'}}" style="float: right;"><i class="fa-solid fa-plus"></i></a>
    </div>
    {{#if grantRows.length}}
    {{! Шапка колонок: пропорции flex совпадают со строками ниже }}
    <div style="grid-column: 1 / -1; display: flex; gap: 4px; opacity: 0.75; font-size: 0.85em;">
        <span style="flex: 3;">{{localize "DEDREL.Crafting.GrantLabel"}}</span>
        <span style="flex: 1;">{{localize "DEDREL.Crafting.GrantBonus"}}</span>
        <span style="flex: 2;">{{localize "DEDREL.Crafting.GrantSlots"}}</span>
        <span style="width: 22px;"></span>
    </div>
    {{/if}}
    {{#each grantRows as |grant|}}
    <div style="grid-column: 1 / -1; display: flex; gap: 4px; align-items: center;">
        <input type="text" class="material-grant-field" data-grant-index="{{grant.index}}" data-grant-field="label" value="{{grant.label}}" placeholder="{{localize 'DEDREL.Crafting.GrantLabelPlaceholder'}}" style="flex: 3;"/>
        <input type="number" class="material-grant-field" data-grant-index="{{grant.index}}" data-grant-field="bonus" value="{{grant.bonus}}" min="0" step="1" title="{{localize 'DEDREL.Crafting.GrantBonusHint'}}" style="flex: 1;"/>
        <input type="text" class="material-grant-field" data-grant-index="{{grant.index}}" data-grant-field="slots" value="{{grant.slotsText}}" placeholder="common; uncommon" title="{{../slotTierHint}}" style="flex: 2;"/>
        <a data-action="deleteMaterialGrant" data-grant-index="{{grant.index}}" title="{{localize 'DEDREL.Crafting.DeleteGrant'}}" style="width: 22px; text-align: center;"><i class="fa-solid fa-trash"></i></a>
    </div>
    {{/each}}
    <p class="hint" style="grid-column: 1 / -1; margin: 4px 0 0;">{{localize "DEDREL.Crafting.GrantsHint"}} ({{slotTierHint}})</p>
</div>
