<div class="tab maneuvers {{tabs.maneuvers.cssClass}}" data-group="primary" data-tab="maneuvers">
    <h2 class="tab-title">Манёвры</h2>
    <div class="item-list">
        <div class="item-list-header flexrow">
            <div class="item-name">Название</div>
            <div class="item-ap-cost">ОД</div>
            <div class="item-controls">
                <a class="item-control" data-action="create" data-type="maneuver" title="Добавить манёвр"><i
                        class="fas fa-plus"></i></a>
            </div>
        </div>
        {{#each maneuvers as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" data-action="useItem" style="cursor: pointer;" />
            </div>
            <div class="item-name" data-action="useItem" style="cursor: pointer;">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-ap-cost">{{item.system.ap_cost}}</div>
            <div class="item-controls">
                <a class="item-control" data-action="toggle-favorite" title="В избранное"><i
                        class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                {{#unless @root.itemsLocked}}<a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>{{/unless}}
            </div>
        </div>
        {{/each}}
    </div>
</div>
