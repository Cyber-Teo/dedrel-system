<div class="creation-wrapper">
    <div class="creation-content">
        <div class="creation-header flexrow">
            <h2>{{localize "DEDREL.Creation.Title"}}</h2>
            <div class="lock-toggle rollable" data-action="toggleCreationLock" title="{{#if actor.flags.dedrel.creationLocked}}{{localize "DEDREL.Creation.UnlockTitle"}}{{else}}{{localize "DEDREL.Creation.LockTitle"}}{{/if}}">
                <i class="fas {{#if actor.flags.dedrel.creationLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
            </div>
        </div>

        {{#if actor.flags.dedrel.creationLocked}}
        <div class="creation-locked-message">
            <p>{{localize "DEDREL.Creation.LockedMessage"}}</p>
        </div>
        {{else}}
        
        <div class="creation-section">
            <h3>{{localize "DEDREL.Creation.Bloodlines"}} ({{localize "DEDREL.Creation.Distributed" used=creationData.bloodlinesUsed max=10}})</h3>
            <div class="bloodlines-grid grid-3col">
                {{#each system.bloodlines as |bloodline key|}}
                <div class="bloodline-item">
                    <span class="bloodline-name">{{localize (concat "DEDREL.Bloodline." key)}}</span>
                    <div class="bloodline-controls">
                        <a class="control-btn" data-action="decreaseBloodline" data-key="{{key}}"><i class="fas fa-minus"></i></a>
                        <span class="bloodline-value">{{bloodline.rank}}</span>
                        <a class="control-btn" data-action="increaseBloodline" data-key="{{key}}"><i class="fas fa-plus"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="creation-section flexrow">
            <div class="mutations-col">
                <h3>{{localize "DEDREL.Creation.UsefulMutations"}} ({{localize "DEDREL.Creation.Points" used=creationData.mutationsUsed max=creationData.mutationsMax}})</h3>
                <p class="hint">{{localize "DEDREL.Creation.DragUsefulHint"}}</p>
                <div class="item-list drop-zone" data-drop-type="mutation-useful">
                    {{#each creationData.startingUsefulMutations as |item|}}
                    <div class="item-row flexrow" data-item-id="{{item.id}}">
                        <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                        <div class="item-name"><h4>{{item.name}} ({{localize "DEDREL.Creation.CostPoints" cost=item.system.xp_cost}})</h4></div>
                        <div class="item-controls">
                            {{#unless @root.itemsLocked}}<a class="item-control item-delete" data-action="delete"><i class="fas fa-trash"></i></a>{{/unless}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            
            <div class="mutations-col">
                <h3>{{localize "DEDREL.Creation.HarmfulMutations"}} ({{localize "DEDREL.Creation.Selected" used=creationData.harmfulMutationsCount max=2}})</h3>
                <p class="hint">{{localize "DEDREL.Creation.DragHarmfulHint"}}</p>
                <div class="item-list drop-zone" data-drop-type="mutation-harmful">
                    {{#each creationData.startingHarmfulMutations as |item|}}
                    <div class="item-row flexrow" data-item-id="{{item.id}}">
                        <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                        <div class="item-name"><h4>{{item.name}}</h4></div>
                        <div class="item-controls">
                            {{#unless @root.itemsLocked}}<a class="item-control item-delete" data-action="delete"><i class="fas fa-trash"></i></a>{{/unless}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="creation-section">
            <h3>{{localize "DEDREL.ActorSheet.Attributes"}} ({{localize "DEDREL.Creation.Distributed" used=creationData.attributesUsed max=10}})</h3>
            <p class="hint">{{localize "DEDREL.Creation.MaxStartingValue" max=4}}</p>
            {{#if creationData.hasOverCapAttributes}}
            <p class="warning" style="color: red; font-weight: bold; margin-top: 0; margin-bottom: 10px;">
                <i class="fas fa-exclamation-triangle"></i> {{localize "DEDREL.Creation.OverCapWarning"}}
            </p>
            {{/if}}
            <div class="attributes-grid grid-3col">
                {{#each system.attributes as |attr key|}}
                <div class="attribute-item">
                    <span class="attribute-name">{{localize (concat "DEDREL.Attributes." key)}}</span>
                    <div class="attribute-controls">
                        <a class="control-btn" data-action="decreaseAttribute" data-key="{{key}}"><i class="fas fa-minus"></i></a>
                        <span class="attribute-value {{#if attr.isOverCap}}over-cap{{/if}}" {{#if attr.isOverCap}}style="color: red; font-weight: bold;"{{/if}}>{{attr.rank}}</span>
                        <a class="control-btn" data-action="increaseAttribute" data-key="{{key}}"><i class="fas fa-plus"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="creation-section">
            <h3>{{localize "DEDREL.Creation.Homeland"}}</h3>
            <input type="text" name="flags.dedrel.homeland" value="{{actor.flags.dedrel.homeland}}" placeholder="{{localize "DEDREL.Creation.HomelandPlaceholder"}}" />
        </div>

        <div class="creation-section">
            <h3>{{localize "DEDREL.UI.Skills"}} ({{localize "DEDREL.Creation.Distributed" used=creationData.skillsUsed max=15}})</h3>
            <p class="hint">{{localize "DEDREL.Creation.MaxStartingValue" max=3}}</p>
            <div class="skills-grid grid-3col">
                {{#each system.skills as |skill key|}}
                <div class="skill-item-create">
                    <span class="skill-name">{{localize (concat "DEDREL.Skills." key)}}</span>
                    <div class="skill-controls">
                        <a class="control-btn" data-action="decreaseSkill" data-key="{{key}}"><i class="fas fa-minus"></i></a>
                        <span class="skill-value">{{skill.rank}}</span>
                        <a class="control-btn" data-action="increaseSkill" data-key="{{key}}"><i class="fas fa-plus"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        
        {{/if}}
    </div>
</div>
