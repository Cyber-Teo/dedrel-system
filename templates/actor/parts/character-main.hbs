<div class="tab main {{tabs.main.cssClass}}" data-group="primary" data-tab="main">
    <div class="tab-content">
        {{!-- Header --}}
        {{> "systems/dedrel/templates/actor/parts/character-header.hbs"}}


        <div class="main-bottom">
            <div class="skills-list">
                <div class="skills-header">
                    <span class="skill-name-header">Название навыка</span>
                    <span class="skill-spec-header">Специализация</span>
                    <span class="skill-rank-header">Ранг</span>
                </div>
                <div class="skills-scrollarea">
                    {{#if favoriteSkillsData.length}}
                    <h3 class="skill-group-header favorite-skills-header"><i class="fas fa-star" style="color: var(--color-text-light-highlight);"></i> Избранные навыки</h3>
                    {{#each favoriteSkillsData as |skill|}}
                    <div class="skill-item" data-skill-id="{{skill.key}}">
                        <a class="skill-control" data-action="toggleSkillFavorite" title="Убрать из избранного" style="margin-right: 5px;">
                            <i class="fas fa-star" style="color: var(--color-text-light-highlight);"></i>
                        </a>
                        <img src="systems/dedrel/assets/icons/skills/{{skill.key}}.svg" onerror="this.src='icons/svg/d20.svg'" width="24" height="24" class="skill-icon" style="margin-right: 5px;" />
                        <a class="skill-name rollable" data-action="rollCheck" data-rank="{{skill.rank}}" data-label="{{localize (concat "DEDREL.Skills." skill.key)}}">{{localize (concat "DEDREL.Skills." skill.key)}}</a>
                        <input type="text" class="skill-spec" name="system.skills.{{skill.key}}.specialization"
                            value="{{skill.specialization}}" />
                        <span class="skill-rank-display">{{skill.rank}}</span>
                    </div>
                    {{/each}}
                    {{/if}}

                    <h3 class="skill-group-header">Боевые навыки</h3>
                    {{#each skillGroups.combat as |skill|}}
                    <div class="skill-item" data-skill-id="{{skill.key}}">
                        <a class="skill-control" data-action="toggleSkillFavorite" title="В избранное" style="margin-right: 5px;">
                            <i class="{{#if skill.isFavorite}}fas{{else}}far{{/if}} fa-star" {{#if skill.isFavorite}}style="color: var(--color-text-light-highlight);"{{/if}}></i>
                        </a>
                        <img src="systems/dedrel/assets/icons/skills/{{skill.key}}.svg" onerror="this.src='icons/svg/d20.svg'" width="24" height="24" class="skill-icon" style="margin-right: 5px;" />
                        <a class="skill-name rollable" data-action="rollCheck" data-rank="{{skill.rank}}" data-label="{{localize (concat "DEDREL.Skills." skill.key)}}">{{localize (concat "DEDREL.Skills." skill.key)}}</a>
                        <input type="text" class="skill-spec" name="system.skills.{{skill.key}}.specialization"
                            value="{{skill.specialization}}" />
                        <span class="skill-rank-display">{{skill.rank}}</span>
                    </div>
                    {{/each}}

                    <h3 class="skill-group-header">Интеллектуальные навыки</h3>
                    {{#each skillGroups.intellectual as |skill|}}
                    <div class="skill-item" data-skill-id="{{skill.key}}">
                        <a class="skill-control" data-action="toggleSkillFavorite" title="В избранное" style="margin-right: 5px;">
                            <i class="{{#if skill.isFavorite}}fas{{else}}far{{/if}} fa-star" {{#if skill.isFavorite}}style="color: var(--color-text-light-highlight);"{{/if}}></i>
                        </a>
                        <img src="systems/dedrel/assets/icons/skills/{{skill.key}}.svg" onerror="this.src='icons/svg/d20.svg'" width="24" height="24" class="skill-icon" style="margin-right: 5px;" />
                        <a class="skill-name rollable" data-action="rollCheck" data-rank="{{skill.rank}}" data-label="{{localize (concat "DEDREL.Skills." skill.key)}}">{{localize (concat "DEDREL.Skills." skill.key)}}</a>
                        <input type="text" class="skill-spec" name="system.skills.{{skill.key}}.specialization"
                            value="{{skill.specialization}}" />
                        <span class="skill-rank-display">{{skill.rank}}</span>
                    </div>
                    {{/each}}

                    <h3 class="skill-group-header">Практические навыки</h3>
                    {{#each skillGroups.practical as |skill|}}
                    <div class="skill-item" data-skill-id="{{skill.key}}">
                        <a class="skill-control" data-action="toggleSkillFavorite" title="В избранное" style="margin-right: 5px;">
                            <i class="{{#if skill.isFavorite}}fas{{else}}far{{/if}} fa-star" {{#if skill.isFavorite}}style="color: var(--color-text-light-highlight);"{{/if}}></i>
                        </a>
                        <img src="systems/dedrel/assets/icons/skills/{{skill.key}}.svg" onerror="this.src='icons/svg/d20.svg'" width="24" height="24" class="skill-icon" style="margin-right: 5px;" />
                        <a class="skill-name rollable" data-action="rollCheck" data-rank="{{skill.rank}}" data-label="{{localize (concat "DEDREL.Skills." skill.key)}}">{{localize (concat "DEDREL.Skills." skill.key)}}</a>
                        <input type="text" class="skill-spec" name="system.skills.{{skill.key}}.specialization"
                            value="{{skill.specialization}}" />
                        <span class="skill-rank-display">{{skill.rank}}</span>
                    </div>
                    {{/each}}

                    <h3 class="skill-group-header">Социальные навыки</h3>
                    {{#each skillGroups.social as |skill|}}
                    <div class="skill-item" data-skill-id="{{skill.key}}">
                        <a class="skill-control" data-action="toggleSkillFavorite" title="В избранное" style="margin-right: 5px;">
                            <i class="{{#if skill.isFavorite}}fas{{else}}far{{/if}} fa-star" {{#if skill.isFavorite}}style="color: var(--color-text-light-highlight);"{{/if}}></i>
                        </a>
                        <img src="systems/dedrel/assets/icons/skills/{{skill.key}}.svg" onerror="this.src='icons/svg/d20.svg'" width="24" height="24" class="skill-icon" style="margin-right: 5px;" />
                        <a class="skill-name rollable" data-action="rollCheck" data-rank="{{skill.rank}}" data-label="{{localize (concat "DEDREL.Skills." skill.key)}}">{{localize (concat "DEDREL.Skills." skill.key)}}</a>
                        <input type="text" class="skill-spec" name="system.skills.{{skill.key}}.specialization"
                            value="{{skill.specialization}}" />
                        <span class="skill-rank-display">{{skill.rank}}</span>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="quick-slots">
                <h3 class="slot-header">Экипированное оружие</h3>
                <div class="item-list">
                    {{#each equippedWeapons as |item id|}}
                    <div class="item-row flexrow" data-item-id="{{item.id}}">
                        <div class="item-image rollable" data-action="useItem"><img src="{{item.img}}" title="{{item.name}}" width="24"
                                height="24" /></div>
                        <div class="item-name rollable" data-action="useItem">
                            <h4>{{item.name}}</h4>
                            {{#if item.system.has_charges}}
                            <span class="item-charges" style="font-size: 0.8em; color: var(--color-text-dark-secondary); margin-left: 5px;">({{item.system.uses_value}}/{{item.system.uses_max}})</span>
                            {{/if}}
                        </div>
                        <div class="item-controls">
                            <a class="item-control" data-action="toggle-favorite"
                                title="Снять экипировку"><i class="fas fa-star"></i></a>
                        </div>
                    </div>
                    {{else}}
                    <div class="item-slot empty-slot">Перетащите оружие сюда или нажмите звездочку в инвентаре
                    </div>
                    {{/each}}
                </div>

                <h3 class="slot-header">Быстрые слоты (Предметы)</h3>
                <div class="item-list">
                    {{#each quickSlots as |item id|}}
                    <div class="item-row flexrow" data-item-id="{{item.id}}">
                        <div class="item-image rollable" data-action="useItem"><img src="{{item.img}}" title="{{item.name}}" width="24"
                                height="24" /></div>
                        <div class="item-name rollable" data-action="useItem">
                            <h4>{{item.name}}</h4>
                            {{#if item.system.has_charges}}
                            <span class="item-charges" style="font-size: 0.8em; color: var(--color-text-dark-secondary); margin-left: 5px;">({{item.system.uses_value}}/{{item.system.uses_max}})</span>
                            {{/if}}
                        </div>
                        <div class="item-controls">
                            <a class="item-control" data-action="toggle-favorite"
                                title="Убрать из избранного"><i class="fas fa-star"></i></a>
                        </div>
                    </div>
                    {{else}}
                    <div class="item-slot empty-slot">Нажмите звездочку у предмета в инвентаре</div>
                    {{/each}}
                </div>

                <h3 class="slot-header">Избранные манёвры и заклинания</h3>
                <div class="item-list">
                    {{#each favoriteManeuversSpells as |item id|}}
                    <div class="item-row flexrow" data-item-id="{{item.id}}">
                        <div class="item-image rollable" data-action="useItem"><img src="{{item.img}}" title="{{item.name}}" width="24"
                                height="24" /></div>
                        <div class="item-name rollable" data-action="useItem">
                            <h4>{{item.name}}</h4>
                            {{#if item.system.has_charges}}
                            <span class="item-charges" style="font-size: 0.8em; color: var(--color-text-dark-secondary); margin-left: 5px;">({{item.system.uses_value}}/{{item.system.uses_max}})</span>
                            {{/if}}
                        </div>
                        <div class="item-controls">
                            <a class="item-control" data-action="toggle-favorite"
                                title="Убрать из избранного"><i class="fas fa-star"></i></a>
                        </div>
                    </div>
                    {{else}}
                    <div class="item-slot empty-slot">Нажмите звездочку у манёвра или заклинания</div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>
