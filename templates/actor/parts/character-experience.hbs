<div class="tab experience {{tabs.experience.cssClass}}" data-group="primary" data-tab="experience">
    <div class="tab-content">
        <div class="experience-header flexrow">
            <h2>{{localize "DEDREL.ActorSheet.ExperienceDistribution"}}</h2>
            <div class="xp-pool">
                <span>{{localize "DEDREL.ActorSheet.CurrentExperience"}}</span>
                <span class="xp-value">{{system.details.xp}}</span>
                <span class="xp-total">{{localize "DEDREL.ActorSheet.TotalGained" total=actor.flags.dedrel.total_xp}}</span>
            </div>
        </div>
        <div class="experience-actions flexrow" style="margin-bottom: 10px;">
            <a class="creation-mode-btn" data-action="toggleCreationView">
                <i class="fas fa-edit"></i> {{#if actor.flags.dedrel.showCreation}}{{localize "DEDREL.ActorSheet.HideCreationView"}}{{else}}{{localize "DEDREL.ActorSheet.ToggleCreationView"}}{{/if}}
            </a>
        </div>

        {{#if actor.flags.dedrel.showCreation}}
            {{> "systems/dedrel/templates/actor/parts/character-creation.hbs"}}
        {{else}}

        <div class="experience-section">
            <h3>{{localize "DEDREL.ActorSheet.AttributeUpgrade"}}</h3>
            {{#if xpData.activeDiscounts.length}}
            <p class="hint" style="margin-top: -5px; margin-bottom: 15px;">
                <strong>{{localize "DEDREL.ActorSheet.ActiveDiscounts"}}</strong> 
                {{#each xpData.activeDiscounts}}
                {{localize (concat "DEDREL.Attributes." this.attrKey)}} (-{{this.discount}} XP){{#unless @last}}, {{/unless}}
                {{/each}}
            </p>
            {{else}}
            <p class="hint" style="margin-top: -5px; margin-bottom: 15px;">{{localize "DEDREL.ActorSheet.NoDiscounts"}}</p>
            {{/if}}
            <div class="attributes-grid grid-3col">
                {{#each system.attributes as |attr key|}}
                {{#with (lookup ../xpData.attributes key) as |xpInfo|}}
                <div class="attribute-item">
                    <span class="attribute-name">{{localize (concat "DEDREL.Attributes." key)}}</span>
                    <span class="attribute-value">{{attr.rank}}</span>
                    {{#if (lt attr.rank 6)}}
                    <a class="upgrade-btn {{#unless xpInfo.canUpgrade}}disabled{{/unless}}" data-action="upgradeAttribute" data-key="{{key}}" data-cost="{{xpInfo.cost}}" {{#unless xpInfo.canUpgrade}}disabled{{/unless}}>
                        <i class="fas fa-arrow-up"></i> {{xpInfo.cost}} XP
                    </a>
                    {{else}}
                    <span class="max-rank">{{localize "DEDREL.ActorSheet.MAX"}}</span>
                    {{/if}}
                </div>
                {{/with}}
                {{/each}}
            </div>
        </div>

        <div class="experience-section">
            <h3>{{localize "DEDREL.ActorSheet.SkillUpgrade"}}</h3>
            <p class="hint" style="margin-top: -5px; margin-bottom: 15px;"><strong>{{localize "DEDREL.ActorSheet.CostHint"}}</strong></p>
            <div class="skills-grid grid-3col">
                {{#each system.skills as |skill key|}}
                {{#with (lookup ../xpData.skills key) as |xpInfo|}}
                <div class="skill-item-create" style="flex-direction: column; align-items: stretch;">
                    <div class="flexrow" style="align-items: center; justify-content: space-between;">
                        <span class="skill-name">{{localize (concat "DEDREL.Skills." key)}}</span>
                        <span class="skill-value" style="margin-right: 10px;">{{skill.rank}}</span>
                        <a class="upgrade-btn {{#unless xpInfo.canUpgrade}}disabled{{/unless}}" data-action="upgradeSkill" data-key="{{key}}" data-cost="{{xpInfo.cost}}" {{#unless xpInfo.canUpgrade}}disabled{{/unless}}>
                            <i class="fas fa-arrow-up"></i> {{xpInfo.cost}} XP
                        </a>
                    </div>
                    {{#if xpInfo.needsSpecialization}}
                    <div class="skill-specialization" style="margin-top: 5px;">
                        <input type="text" name="system.skills.{{key}}.specialization" value="{{skill.specialization}}" placeholder="{{localize "DEDREL.ActorSheet.SpecifySpecialization"}}" style="width: 100%; height: 24px; font-size: 0.9em;" {{#if @root.itemsLocked}}disabled{{/if}} />
                    </div>
                    {{/if}}
                </div>
                {{/with}}
                {{/each}}
            </div>
        </div>

        <div class="experience-section">
            <h3>{{localize "DEDREL.ActorSheet.DoctrineUpgrade"}}</h3>
            {{#if xpData.hasDoctrines}}
            <p class="hint" style="margin-top: -5px; margin-bottom: 15px;">{{localize "DEDREL.ActorSheet.DoctrineUpgradeHint"}}</p>
            {{#each xpData.doctrineGroups as |group|}}
            <h4 class="doctrine-group-title">{{localize (concat "DEDREL.Magic.DoctrineGroups." group.key)}}</h4>
            <div class="attributes-grid grid-3col">
                {{#each group.doctrines as |doctrine|}}
                <div class="attribute-item">
                    <span class="attribute-name">{{localize (concat "DEDREL.Magic.Doctrines." doctrine.key)}}</span>
                    <span class="attribute-value">{{doctrine.rank}}</span>
                    {{#if doctrine.isMax}}
                    <span class="max-rank">{{localize "DEDREL.ActorSheet.MAX"}}</span>
                    {{else}}
                    <a class="upgrade-btn {{#unless doctrine.canUpgrade}}disabled{{/unless}}" data-action="upgradeDoctrine" data-key="{{doctrine.key}}" {{#unless doctrine.canUpgrade}}disabled{{/unless}}>
                        <i class="fas fa-arrow-up"></i> {{doctrine.cost}} XP
                    </a>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            {{/each}}
            {{else}}
            <p class="hint">{{localize "DEDREL.ActorSheet.NoDoctrinesUnlocked"}}</p>
            {{/if}}
        </div>

        <div class="experience-section">
            <h3>{{localize "DEDREL.ActorSheet.BuyTalentsMutations"}}</h3>
            <p class="hint">{{localize "DEDREL.ActorSheet.DragHint"}}</p>
        </div>

        {{/if}}
    </div>
</div>
