<div class="tab biography {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
    <div class="biography-layout" style="display: flex; gap: 20px; height: 100%;">
        <div class="bio-image-col" style="flex: 0 0 200px; display: flex; flex-direction: column; gap: 10px; align-items: center;">
            <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" style="cursor: pointer; width: 200px; height: 200px; object-fit: cover; border: 2px solid var(--color-border); border-radius: 5px;"/>
            <h2 style="margin: 0; text-align: center;">{{localize "DEDREL.ActorSheet.Avatar"}}</h2>
        </div>
        <div class="bio-text-col" style="flex: 1; display: flex; flex-direction: column; background: rgba(0, 0, 0, 0.2); border: 1px solid var(--color-border); border-radius: 5px; padding: 10px;">
            <h2 style="margin-top: 0;">{{localize "DEDREL.ActorSheet.BiographyAndDescription"}}</h2>
            <div class="editor-container" style="flex: 1; overflow-y: auto;">
                <prose-mirror name="system.details.biography" data-document-u-u-i-d="{{actor.uuid}}" value="{{system.details.biography}}" toggled="true" collaborate="false">
                    {{{enrichedBiography}}}
                </prose-mirror>
            </div>
        </div>
    </div>
</div>
