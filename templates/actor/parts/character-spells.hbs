<div class="tab spells {{tabs.spells.cssClass}}" data-group="primary" data-tab="spells">
    <h2 class="tab-title">{{localize "DEDREL.ActorSheet.Spells"}}</h2>
    <div class="spells-toolbar">
        <a class="creation-mode-btn" data-action="openSpellConstructor">
            <i class="fa-solid fa-wand-sparkles"></i> {{localize "DEDREL.Magic.UI.OpenConstructor"}}
        </a>
        {{#each doctrinePaths as |d|}}
        <span class="doctrine-path-toggle" data-tooltip="{{localize 'DEDREL.Magic.UI.KnownPathsHint'}}">
            <span class="doctrine-path-name">{{d.label}}:</span>
            {{#each d.paths as |p|}}
            <span class="doctrine-path-btn active">{{p.label}}</span>
            {{/each}}
        </span>
        {{/each}}
    </div>
    <div class="item-list">
        {{#each spells as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name rollable" data-action="useItem" style="cursor: pointer;">
                <h4>{{item.name}}</h4>
                {{#if item.flags.dedrel.ephemeral}}
                <i class="fa-solid fa-hourglass-half item-ephemeral-icon" data-tooltip="{{localize "DEDREL.ActorSheet.EphemeralSpellHint"}}" style="font-size: 0.8em; opacity: 0.7; margin-left: 5px;"></i>
                {{/if}}
                {{#if item.system.has_charges}}
                <span class="item-charges" style="font-size: 0.8em; color: var(--color-text-dark-secondary); margin-left: 5px;">({{item.system.uses_value}}/{{item.system.uses_max}})</span>
                {{/if}}
            </div>
            <div class="item-controls">
                {{#if item.flags.dedrel.ephemeral}}
                <a class="item-control" data-action="pinSpell" title="{{localize "DEDREL.ActorSheet.PinSpell"}}"><i class="fa-solid fa-thumbtack"></i></a>
                {{/if}}
                <a class="item-control" data-action="toggle-favorite" title="{{localize "DEDREL.ActorSheet.ToggleFavorite"}}"><i
                        class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
                {{#unless @root.itemsLocked}}<a class="item-control" data-action="delete" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fas fa-trash"></i></a>{{/unless}}
            </div>
        </div>
        {{/each}}
    </div>
</div>
