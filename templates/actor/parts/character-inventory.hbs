<div class="tab inventory" data-group="primary" data-tab="inventory">
    <h2 class="tab-title">Оружие</h2>
    <div class="item-list">
        {{#each weapons as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="toggle-favorite" title="Экипировать"><i
                        class="{{#if item.system.equipped}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
            </div>
        </div>
        {{/each}}
    </div>

    <h2 class="tab-title">Броня</h2>
    <div class="item-list">
        {{#each armors as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="toggle-favorite" title="Экипировать"><i
                        class="{{#if item.system.equipped}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
            </div>
        </div>
        {{/each}}
    </div>

    <h2 class="tab-title">Магические предметы</h2>
    <div class="item-list">
        {{#each magic_items as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="toggle-favorite" title="В избранное"><i
                        class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
            </div>
        </div>
        {{/each}}
    </div>

    <h2 class="tab-title">Прочий инвентарь</h2>
    <div class="item-list">
        <div class="item-list-header flexrow">
            <div class="item-name">Название</div>
            <div class="item-controls">
                <a class="item-control" data-action="create" data-type="loot" title="Добавить предмет"><i
                        class="fas fa-plus"></i></a>
            </div>
        </div>
        {{#each inventory as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="toggle-favorite" title="В избранное"><i
                        class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
            </div>
        </div>
        {{/each}}
    </div>
</div>