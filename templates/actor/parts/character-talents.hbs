<div class="tab talents {{tabs.talents.cssClass}}" data-group="primary" data-tab="talents">
    <h2 class="tab-title">{{localize "DEDREL.ActorSheet.Talents"}}</h2>
    <div class="item-list">
        {{#each talentsGroups as |group key|}}
        {{#if group.items.length}}
        <h3 class="slot-header">{{localize group.label}}</h3>
        {{#each group.items as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" data-action="useItem" style="cursor: pointer;" />
            </div>
            <div class="item-name" data-action="useItem" style="cursor: pointer;">
                <h4>{{item.name}}</h4>
                {{#if item.system.has_charges}}
                <span class="item-charges" style="font-size: 0.8em; color: var(--color-text-dark-secondary); margin-left: 5px;">({{item.system.uses_value}}/{{item.system.uses_max}})</span>
                {{/if}}
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="edit" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
                {{#unless @root.itemsLocked}}<a class="item-control" data-action="delete" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fas fa-trash"></i></a>{{/unless}}
            </div>
        </div>
        {{/each}}
        {{/if}}
        {{/each}}
    </div>
</div>
