<div class="tab statuses {{tabs.statuses.cssClass}}" data-group="primary" data-tab="statuses">
    <h2 class="tab-title">{{localize "DEDREL.ActorSheet.Mutilations"}}</h2>
    <div class="item-list">
        {{#each mutilations as |item id|}}
        <div class="item-row flexrow" data-item-id="{{item.id}}">
            <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
            </div>
            <div class="item-name">
                <h4>{{item.name}}</h4>
            </div>
            <div class="item-controls">
                <a class="item-control" data-action="edit" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
                {{#unless @root.itemsLocked}}<a class="item-control" data-action="delete" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fas fa-trash"></i></a>{{/unless}}
            </div>
        </div>
        {{/each}}
    </div>

    <h2 class="tab-title" style="margin-top: 15px;">{{localize "DEDREL.ActorSheet.TemporaryEffects"}}</h2>
    <div class="item-list">
        {{#each temporaryEffects as |effect id|}}
        <div class="item-row flexrow effect-row" data-effect-id="{{effect.id}}">
            <div class="item-image"><img src="{{effect.displayIcon}}" title="{{effect.name}}" width="24" height="24" /></div>
            <div class="item-name">
                <h4 style="{{#if effect.disabled}}text-decoration: line-through; opacity: 0.6;{{/if}}">{{effect.name}}</h4>
            </div>
            <div class="item-controls" style="flex: 0 0 80px; justify-content: flex-end; display: flex; gap: 5px;">
                <a class="effect-control" data-action="toggleEffect" title="{{#if effect.disabled}}{{localize "DEDREL.ActorSheet.Enable"}}{{else}}{{localize "DEDREL.ActorSheet.Disable"}}{{/if}}">
                    <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                </a>
                <a class="effect-control" data-action="editEffect" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
                <a class="effect-control" data-action="deleteEffect" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fas fa-trash"></i></a>
            </div>
        </div>
        {{else}}
        <p class="hint">{{localize "DEDREL.ActorSheet.NoTemporaryEffects"}}</p>
        {{/each}}
    </div>

    <h2 class="tab-title" style="margin-top: 15px;">{{localize "DEDREL.ActorSheet.PermanentEffects"}}</h2>
    <div class="item-list">
        {{#each permanentEffects as |effect id|}}
        <div class="item-row flexrow effect-row" data-effect-id="{{effect.id}}" data-parent-id="{{effect.parent.id}}">
            <div class="item-image"><img src="{{effect.displayIcon}}" title="{{effect.name}}" width="24" height="24" /></div>
            <div class="item-name" style="flex: 1;">
                <h4 style="{{#if effect.disabled}}text-decoration: line-through; opacity: 0.6;{{/if}}">
                    {{effect.name}} <span style="font-weight: normal; font-size: 0.9em; opacity: 0.7;">({{localize "DEDREL.ItemSheet.Source"}}: {{effect.parent.name}})</span>
                </h4>
            </div>
            <div class="item-controls" style="flex: 0 0 60px; justify-content: flex-end; display: flex; gap: 5px;">
                <a class="effect-control" data-action="toggleEffect" title="{{#if effect.disabled}}{{localize "DEDREL.ActorSheet.Enable"}}{{else}}{{localize "DEDREL.ActorSheet.Disable"}}{{/if}}">
                    <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                </a>
                <a class="effect-control" data-action="editEffect" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
                <span title="{{localize "DEDREL.ActorSheet.CannotDeleteEffect"}}"><i class="fas fa-lock" style="opacity: 0.5;"></i></span>
            </div>
        </div>
        {{else}}
        <p class="hint">{{localize "DEDREL.ActorSheet.NoPermanentEffects"}}</p>
        {{/each}}
    </div>
</div>
