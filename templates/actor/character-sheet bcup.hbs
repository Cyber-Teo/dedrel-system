<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Header --}}
    <header class="sheet-header flexrow">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
        <div class="header-details flexcol">
            <h1 class="charname">
                <input name="name" type="text" value="{{actor.name}}" placeholder="Имя персонажа"/>
            </h1>
            
            <div class="header-stats flexrow">
                <div class="stat-block hp-block flexrow">
                    <label>HP</label>
                    <div class="stat-inputs">
                        <input type="text" name="system.resources.hp.value" value="{{system.resources.hp.value}}" data-dtype="Number"/>
                        <span class="separator">/</span>
                        <span class="max-val" title="Максимум">{{system.resources.hp.max}}</span>
                    </div>
                </div>
                <div class="stat-block temp-hp-block flexrow">
                    <label>Temp HP</label>
                    <input type="text" name="system.resources.hp.temp" value="{{system.resources.hp.temp}}" data-dtype="Number"/>
                </div>
                <div class="stat-block exp-block flexrow">
                    <label>EXP (Free / Total)</label>
                    <input type="text" name="system.details.xp" value="{{system.details.xp}}" data-dtype="Number"/>
                </div>
            </div>

            <div class="ap-bars flexrow">
                <div class="ap-bar universal">
                    <input type="text" name="system.resources.ap_universal.value" value="{{system.resources.ap_universal.value}}" data-dtype="Number"/>
                    <span class="separator">/</span>
                    <span class="max-val">{{system.resources.ap_universal.max}}</span>
                    <label>Universal AP</label>
                </div>
                <div class="ap-bar maneuver">
                    <input type="text" name="system.resources.ap_maneuver.value" value="{{system.resources.ap_maneuver.value}}" data-dtype="Number"/>
                    <span class="separator">/</span>
                    <span class="max-val">{{system.resources.ap_maneuver.max}}</span>
                    <label>Maneuver AP</label>
                </div>
                <div class="ap-bar magic">
                    <input type="text" name="system.resources.ap_magic.value" value="{{system.resources.ap_magic.value}}" data-dtype="Number"/>
                    <span class="separator">/</span>
                    <span class="max-val">{{system.resources.ap_magic.max}}</span>
                    <label>Magic AP</label>
                </div>
            </div>
        </div>
    </header>

    {{!-- Tabs Navigation --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="main">Основное</a>
        <a class="item" data-tab="inventory">Инвентарь</a>
        <a class="item" data-tab="maneuvers">Манёвры</a>
        <a class="item" data-tab="spells">Заклинания</a>
        <a class="item" data-tab="mutations">Мутации</a>
        <a class="item" data-tab="talents">Таланты</a>
        <a class="item" data-tab="statuses">Статусы</a>
        <a class="item" data-tab="experience">Опыт</a>
    </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Main Tab --}}
        <div class="tab main" data-group="primary" data-tab="main">
            <div class="tab-content">
                <div class="main-top">
                    <div class="biography-box">
                        <textarea name="system.details.biography" placeholder="Языки, происхождение и т.д.">{{system.details.biography}}</textarea>
                    </div>

                    <div class="attributes-grid">
                        <div class="attributes-header">
                            <span>ATTR</span>
                            <span>RANK</span>
                            <span>SAVE</span>
                        </div>
                        {{#each system.attributes as |attr key|}}
                        <div class="attribute-block">
                            <span class="attr-name">{{localize (concat "DEDREL.Attributes." key)}}</span>
                            <input type="text" name="system.attributes.{{key}}.rank" value="{{attr.rank}}" data-dtype="Number" title="Rank"/>
                            <span class="attr-save" title="Save Base (Readonly)">{{attr.rank}}</span>
                        </div>
                        {{/each}}
                        <div class="attribute-block speed-block">
                            <span class="attr-name">SPEED</span>
                            <span class="derived-val">{{system.movement}}</span>
                            <span></span>
                        </div>
                    </div>

                    <div class="defenses-box">
                        <div class="defense-item">
                            <label>BLOCK</label>
                            <span class="derived-val">{{system.defenses.block}}</span>
                        </div>
                        <div class="defense-item">
                            <label>DODGE</label>
                            <span class="derived-val">{{system.defenses.dodge}}</span>
                        </div>
                        <div class="defense-item">
                            <label>MDEF</label>
                            <span class="derived-val">{{system.defenses.mdef}}</span>
                        </div>
                        <div class="defense-item">
                            <label>INIT</label>
                            <span class="derived-val">{{system.initiative}}</span>
                        </div>
                    </div>
                </div>

                <hr class="main-divider">

                <div class="main-bottom">
                    <div class="skills-list">
                        <div class="skills-header">
                            <span class="skill-name-header">Название навыка</span>
                            <span class="skill-spec-header">Специализация</span>
                            <span class="skill-rank-header">Ранг</span>
                        </div>
                        <div class="skills-scrollarea">
                            {{#each system.skills as |skill key|}}
                            <div class="skill-item" data-skill-id="{{key}}">
                                <span class="skill-name rollable" data-roll-type="skill">{{localize (concat "DEDREL.Skills." key)}}</span>
                                <input type="text" class="skill-spec" name="system.skills.{{key}}.specialization" value="{{skill.specialization}}"/>
                                <input type="text" class="skill-rank" name="system.skills.{{key}}.rank" value="{{skill.rank}}" data-dtype="Number"/>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    <div class="quick-slots">
                        <h3 class="slot-header">Экипированное оружие</h3>
                        <div class="item-list">
                            {{#each equippedWeapons as |item id|}}
                            <div class="item-row flexrow" data-item-id="{{item.id}}">
                                <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                                <div class="item-name"><h4>{{item.name}}</h4></div>
                                <div class="item-controls">
                                    <a class="item-control" data-action="toggle-favorite" title="Убрать из избранного"><i class="fas fa-star"></i></a>
                                </div>
                            </div>
                            {{else}}
                            <div class="item-slot empty-slot">Перетащите оружие сюда или нажмите звездочку в инвентаре</div>
                            {{/each}}
                        </div>
                        
                        <h3 class="slot-header">Быстрые слоты (Предметы)</h3>
                        <div class="item-list">
                            {{#each quickSlots as |item id|}}
                            <div class="item-row flexrow" data-item-id="{{item.id}}">
                                <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                                <div class="item-name"><h4>{{item.name}}</h4></div>
                                <div class="item-controls">
                                    <a class="item-control" data-action="toggle-favorite" title="Убрать из избранного"><i class="fas fa-star"></i></a>
                                </div>
                            </div>
                            {{else}}
                            <div class="item-slot empty-slot">Нажмите звездочку у предмета в инвентаре</div>
                            {{/each}}
                        </div>
                        
                        <h3 class="slot-header">Избранные манёвры и заклинания</h3>
                        <div class="item-list">
                            {{#each favoriteManeuversSpells as |item id|}}
                            <div class="item-row flexrow" data-item-id="{{item.id}}">
                                <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                                <div class="item-name"><h4>{{item.name}}</h4></div>
                                <div class="item-controls">
                                    <a class="item-control" data-action="toggle-favorite" title="Убрать из избранного"><i class="fas fa-star"></i></a>
                                </div>
                            </div>
                            {{else}}
                            <div class="item-slot empty-slot">Нажмите звездочку у манёвра или заклинания</div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Inventory Tab --}}
        <div class="tab inventory" data-group="primary" data-tab="inventory">
            <h2 class="tab-title">Оружие</h2>
            <div class="item-list">
                {{#each weapons as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>

            <h2 class="tab-title">Броня</h2>
            <div class="item-list">
                {{#each armors as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>

            <h2 class="tab-title">Магические предметы</h2>
            <div class="item-list">
                {{#each magic_items as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>

            <h2 class="tab-title">Прочий инвентарь</h2>
            <div class="item-list">
                <div class="item-list-header flexrow">
                    <div class="item-name">Название</div>
                    <div class="item-controls">
                        <a class="item-control item-create" data-type="loot" title="Добавить предмет"><i class="fas fa-plus"></i></a>
                    </div>
                </div>
                {{#each inventory as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Maneuvers Tab --}}
        <div class="tab maneuvers" data-group="primary" data-tab="maneuvers">
            <h2 class="tab-title">Манёвры</h2>
            <div class="item-list">
                <div class="item-list-header flexrow">
                    <div class="item-name">Название</div>
                    <div class="item-ap-cost">ОД</div>
                    <div class="item-controls">
                        <a class="item-control item-create" data-type="maneuver" title="Добавить манёвр"><i class="fas fa-plus"></i></a>
                    </div>
                </div>
                {{#each maneuvers as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-ap-cost">{{item.system.ap_cost}}</div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Spells Tab --}}
        <div class="tab spells" data-group="primary" data-tab="spells">
            <h2 class="tab-title">Заклинания</h2>
            <div class="item-list">
                {{#each spells as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="toggle-favorite" title="В избранное"><i class="{{#if item.flags.dedrel.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></a>
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Mutations Tab --}}
        <div class="tab mutations" data-group="primary" data-tab="mutations">
            <h2 class="tab-title">Мутации</h2>
            <div class="item-list">
                {{#each mutations as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Talents Tab --}}
        <div class="tab talents" data-group="primary" data-tab="talents">
            <h2 class="tab-title">Таланты</h2>
            <div class="item-list">
                {{#each talents as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Statuses Tab --}}
        <div class="tab statuses" data-group="primary" data-tab="statuses">
            <h2 class="tab-title">Увечья (Mutilations)</h2>
            <div class="item-list">
                {{#each mutilations as |item id|}}
                <div class="item-row flexrow" data-item-id="{{item.id}}">
                    <div class="item-image"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{item.name}}</h4></div>
                    <div class="item-controls">
                        <a class="item-control" data-action="edit" title="Редактировать"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-action="delete" title="Удалить"><i class="fas fa-trash"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>

            <h2 class="tab-title">Активные эффекты</h2>
            <div class="item-list">
                {{#each activeEffects as |effect id|}}
                <div class="item-row flexrow effect-row" data-effect-id="{{effect.id}}">
                    <div class="item-image"><img src="{{effect.icon}}" title="{{effect.name}}" width="24" height="24"/></div>
                    <div class="item-name"><h4>{{effect.name}}</h4></div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Experience Tab --}}
        <div class="tab experience" data-group="primary" data-tab="experience">
            <h2 class="tab-title">Распределение опыта</h2>
            <div class="placeholder-msg">Здесь будет располагаться интерфейс для покупки навыков, атрибутов и талантов (В разработке).</div>
        </div>

    </section>
</form>
