<div class="loot-sheet">

    <header class="loot-header">
        <img class="profile-img loot-img" src="{{actor.img}}" {{#if isGM}}data-action="editImage"{{/if}} title="{{actor.name}}" width="48" height="48"/>
        <div class="loot-header-main">
            <input class="loot-name" name="name" type="text" value="{{actor.name}}" {{#unless isGM}}readonly{{/unless}}/>
            <div class="loot-mode-row">
                <label>{{localize "DEDREL.Loot.Mode"}}:</label>
                {{#if isGM}}
                <select name="system.mode">{{selectOptions modeOptions selected=system.mode}}</select>
                {{else}}
                <span>{{lookup modeOptions system.mode}}</span>
                {{/if}}
            </div>
        </div>
    </header>

    {{!-- Экономика торговца (GM) --}}
    {{#if isMerchant}}
    {{#if isGM}}
    <fieldset class="loot-section">
        <legend>{{localize "DEDREL.Loot.Economy"}}</legend>
        <div class="loot-econ-grid">
            <label>{{localize "DEDREL.Loot.BuyModifier"}} (%)
                <input type="number" name="system.buy_modifier_pct" value="{{system.buy_modifier_pct}}" data-dtype="Number"/>
            </label>
            <label>{{localize "DEDREL.Loot.SellPricePct"}} (%)
                <input type="number" name="system.sell_price_pct" value="{{system.sell_price_pct}}" min="0" data-dtype="Number"/>
            </label>
            <label class="checkbox"><input type="checkbox" name="system.can_sell_to" {{checked system.can_sell_to}}/> {{localize "DEDREL.Loot.CanSellTo"}}</label>
            <label class="checkbox"><input type="checkbox" name="system.infinite_funds" {{checked system.infinite_funds}}/> {{localize "DEDREL.Loot.InfiniteFunds"}}</label>
        </div>

        <div class="loot-subsection">
            <label class="loot-subhead">{{localize "DEDREL.Loot.PersonalDiscounts"}} (%)</label>
            {{#each discountRows as |row|}}
            <div class="loot-discount-row">
                <span>{{row.name}}</span>
                <input type="number" name="system.personal_discounts.{{row.userId}}" value="{{row.pct}}" data-dtype="Number"/>
            </div>
            {{/each}}
        </div>

        <div class="loot-subsection">
            <label class="loot-subhead">{{localize "DEDREL.Loot.LootTables"}}</label>
            <input type="text" name="system.loot_tables" value="{{lootTablesText}}" placeholder="Имя таблицы; другая таблица"/>
            <button type="button" class="loot-btn" data-action="rollStock"><i class="fas fa-dice"></i> {{localize "DEDREL.Loot.RollStock"}}</button>
        </div>
    </fieldset>
    {{/if}}
    {{/if}}

    {{!-- Кошелёк --}}
    <fieldset class="loot-section">
        <legend>{{localize "DEDREL.ActorSheet.Wallet"}} ({{walletTotal}})</legend>
        <div class="loot-wallet-row">
            {{#each walletCurrencies as |cur|}}
            <div class="loot-coin">
                <label><i class="fas fa-circle" style="color: {{cur.color}};"></i> {{cur.abbr}}</label>
                <input type="number" name="system.currency.{{cur.key}}" value="{{cur.count}}" min="0" data-dtype="Number" {{#unless isGM}}readonly{{/unless}}/>
            </div>
            {{/each}}
        </div>
        {{#if isLoot}}
        <button type="button" class="loot-btn" data-action="divideCoins"><i class="fas fa-scale-balanced"></i> {{localize "DEDREL.Loot.DivideCoins"}}</button>
        {{/if}}
        {{#if isContainer}}
        <button type="button" class="loot-btn" data-action="transferMoney"><i class="fas fa-hand-holding-dollar"></i> {{localize "DEDREL.ActorSheet.TransferMoney"}}</button>
        {{/if}}
        {{#if isGM}}
        <label class="checkbox loot-receive-flag" title="{{localize "DEDREL.ActorSheet.CanReceiveCurrencyHint"}}">
            <input type="checkbox" name="system.can_receive_currency" {{checked system.can_receive_currency}}/> {{localize "DEDREL.ActorSheet.CanReceiveCurrency"}}
        </label>
        {{/if}}
    </fieldset>

    {{!-- Вместимость контейнера --}}
    {{#if isContainer}}
    <fieldset class="loot-section">
        <legend>{{localize "DEDREL.Loot.Capacity"}}</legend>
        <div class="loot-capacity-row">
            <span class="loot-load {{#if overCapacity}}over{{/if}}">
                {{localize "DEDREL.Loot.Load"}}: {{numberFormat load decimals=1}} /
                {{#if capacity}}{{numberFormat capacity decimals=0}} {{localize "DEDREL.Units.Kg"}}{{else}}{{localize "DEDREL.Loot.Unlimited"}}{{/if}}
            </span>
            {{#if isGM}}
            <label class="loot-maxload">{{localize "DEDREL.Loot.MaxLoad"}}
                <input type="number" name="system.capacity" value="{{system.capacity}}" min="0" data-dtype="Number"/>
            </label>
            {{/if}}
        </div>
        {{#if capacity}}
        <div class="loot-bar-track">
            <div class="loot-bar-fill {{#if overCapacity}}over{{/if}}" style="width: {{loadPct}}%;"></div>
        </div>
        {{/if}}
    </fieldset>
    {{/if}}

    {{!-- Сток предметов --}}
    <fieldset class="loot-section loot-section--grow">
        <legend>{{localize "DEDREL.Loot.Stock"}}
            {{#if isGM}}<a data-action="createItem" data-type="loot" title="{{localize "DEDREL.ActorSheet.Add"}}"><i class="fas fa-plus"></i></a>{{/if}}
        </legend>
        {{#each items as |item|}}
        <div class="loot-item-row" data-item-id="{{item.id}}">
            <img src="{{item.img}}" width="24" height="24"/>
            <span class="loot-item-name">{{item.name}}{{#if item.quantity}} <span class="loot-item-qty">×{{item.quantity}}</span>{{/if}}</span>
            {{#if @root.isMerchant}}
                <span class="loot-item-price" title="{{localize "DEDREL.Loot.BuyPrice"}}">{{item.buyPriceLabel}}</span>
                {{#if item.isService}}
                <a class="item-control" data-action="buyService" title="{{localize "DEDREL.Loot.Buy"}}"><i class="fas fa-hand-holding-dollar"></i></a>
                {{else}}
                <a class="item-control" data-action="buyItem" title="{{localize "DEDREL.Loot.Buy"}}"><i class="fas fa-cart-shopping"></i></a>
                {{/if}}
            {{else}}
                <a class="item-control" data-action="takeItem" title="{{localize "DEDREL.Loot.Take"}}"><i class="fas fa-hand"></i></a>
            {{/if}}
            {{#if @root.isGM}}
            <a class="item-control" data-action="editItem" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fas fa-edit"></i></a>
            <a class="item-control" data-action="deleteItem" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fas fa-trash"></i></a>
            {{/if}}
        </div>
        {{else}}
        <p class="loot-empty">{{localize "DEDREL.Loot.Empty"}}</p>
        {{/each}}
        {{#if isMerchant}}<p class="hint loot-hint">{{localize "DEDREL.Loot.SellHint"}}</p>{{/if}}
    </fieldset>
</div>
