<div class="npc-sheet-body" style="display:flex; flex-direction:column; gap:10px; padding:8px;">

  {{!-- Шапка: аватар, имя, тир --}}
  <header style="display:flex; gap:10px; align-items:center;">
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" title="{{actor.name}}"
         style="width:64px; height:64px; object-fit:cover; border-radius:6px; cursor:pointer; flex:0 0 auto;"/>
    <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize "DEDREL.Npc.Name"}}"
             style="font-size:18px; font-weight:bold; width:100%;"/>
      <div style="display:flex; gap:8px; align-items:center;">
        <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.Npc.Tier"}}</label>
        <select name="system.tier">
          {{#each tierOptions as |label key|}}
            <option value="{{key}}" {{#if (eq key ../system.tier)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <input type="text" name="system.details.threat" value="{{system.details.threat}}"
               placeholder="{{localize "DEDREL.Npc.Threat"}}" style="flex:1;"/>
      </div>
    </div>
  </header>

  {{!-- Здоровье + ОД + защиты --}}
  <section style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px;">
    <div class="npc-box" style="border:1px solid var(--color-border-light-tertiary,#0002); border-radius:6px; padding:6px;">
      {{#if isPeon}}
        <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.Npc.Hits"}}</div>
        <div style="display:flex; align-items:center; gap:4px;">
          <input type="number" name="system.resources.hits.value" value="{{system.resources.hits.value}}" style="width:56px;"/>
          <span>/</span>
          <input type="number" name="system.resources.hits.max" value="{{system.resources.hits.max}}" style="width:56px;"/>
        </div>
        <div style="display:flex; align-items:center; gap:4px; margin-top:6px;">
          <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.Npc.Toughness"}}</label>
          <input type="number" name="system.toughness" value="{{system.toughness}}" style="width:56px;"/>
        </div>
      {{else}}
        <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.ActorSheet.HP"}}</div>
        <div style="display:flex; align-items:center; gap:4px;">
          <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}" style="width:56px;"/>
          <span>/</span>
          <span title="{{localize "DEDREL.Npc.Derived"}}"><b>{{system.resources.hp.max}}</b></span>
        </div>
        <div style="display:flex; align-items:center; gap:4px; margin-top:6px;">
          <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.Npc.OverrideHpMax"}}</label>
          <input type="number" name="system.overrides.hp_max" value="{{system.overrides.hp_max}}" placeholder="auto" style="width:56px;"/>
        </div>
      {{/if}}
    </div>

    <div class="npc-box" style="border:1px solid var(--color-border-light-tertiary,#0002); border-radius:6px; padding:6px;">
      <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.ActorSheet.ActionPoints"}}</div>
      <div style="display:flex; align-items:center; gap:4px;">
        <input type="number" name="system.resources.ap_universal.value" value="{{system.resources.ap_universal.value}}" style="width:56px;"/>
        <span>/</span>
        <span><b>{{system.resources.ap_universal.max}}</b></span>
      </div>
      <div style="display:flex; align-items:center; gap:4px; margin-top:6px;">
        <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.Npc.OverrideApMax"}}</label>
        <input type="number" name="system.overrides.ap_max" value="{{system.overrides.ap_max}}" placeholder="auto" style="width:56px;"/>
      </div>
    </div>
  </section>

  <section style="display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; text-align:center;">
    <div><div style="font-size:11px; opacity:.7;">{{localize "DEDREL.ActorSheet.Block"}}</div><b>{{system.defenses.block}}</b></div>
    <div><div style="font-size:11px; opacity:.7;">{{localize "DEDREL.ActorSheet.Dodge"}}</div><b>{{system.defenses.dodge}}</b></div>
    <div><div style="font-size:11px; opacity:.7;">{{localize "DEDREL.ActorSheet.MagicDef"}}</div><b>{{system.defenses.mdef}}</b></div>
    <div><div style="font-size:11px; opacity:.7;">{{localize "DEDREL.ActorSheet.Initiative"}}</div><b>{{system.initiative}}</b></div>
  </section>

  <section style="display:flex; gap:12px; align-items:center;">
    <div style="display:flex; align-items:center; gap:4px;">
      <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.ActorSheet.Speed"}}</label>
      <b>{{system.resources.movement.max}}</b>
      <input type="number" name="system.overrides.movement_max" value="{{system.overrides.movement_max}}" placeholder="auto" style="width:50px;"/>
    </div>
    <div style="display:flex; align-items:center; gap:4px;">
      <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.ActorSheet.WoundsPenalty"}}</label>
      <b>{{system.resources.wounds.penalty}}</b>
    </div>
  </section>

  {{!-- Атрибуты --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.ActorSheet.Attributes"}}</div>
    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px;">
      {{#each attributes as |attr|}}
        <div style="display:flex; align-items:center; gap:4px;">
          <label style="flex:1; font-size:12px;">{{localize attr.label}}</label>
          <input type="number" name="system.attributes.{{attr.key}}.rank" value="{{attr.rank}}" style="width:44px;"/>
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- DR по типам. Инпут = база (source), справа мелким — эффективный DR
        (с бронёй/эффектами). Правка инпута меняет только базу. --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.ActorSheet.DamageResistance"}} <span style="font-weight:normal; opacity:.6; font-size:11px;">({{localize "DEDREL.Npc.DrBase"}} / {{localize "DEDREL.Npc.DrEffective"}})</span></div>

    {{!-- Типы существа (Item creature_type) — влияют на «оружие против типа» --}}
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:6px;">
      <label style="font-size:12px; opacity:.8;">{{localize "DEDREL.Npc.CreatureType"}}:</label>
      {{#each creatureTypes as |ct|}}
        <span class="npc-item-row" data-item-id="{{ct.id}}"
              style="display:inline-flex; align-items:center; gap:4px; padding:2px 6px; border:1px solid var(--color-border-light-tertiary,#0003); border-radius:10px; font-size:12px;">
          {{#if ct.label}}{{ct.label}}{{else}}{{ct.name}}{{/if}}
          <a data-action="editItem" title="{{localize "DEDREL.ActorSheet.Edit"}}"><i class="fa-solid fa-edit"></i></a>
          <a data-action="deleteItem" title="{{localize "DEDREL.ActorSheet.Delete"}}"><i class="fa-solid fa-xmark"></i></a>
        </span>
      {{else}}
        <span style="font-size:11px; opacity:.5;">{{localize "DEDREL.Npc.DropHint"}}</span>
      {{/each}}
    </div>

    <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:4px; font-size:12px;">
      <div title="{{localize "DEDREL.ItemFields.Slashing"}}"><i class="fa-solid fa-slash"></i><input type="number" name="system.dr.slashing" value="{{srcDr.slashing}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.slashing}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Piercing"}}"><i class="fa-solid fa-bullseye"></i><input type="number" name="system.dr.piercing" value="{{srcDr.piercing}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.piercing}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Bludgeoning"}}"><i class="fa-solid fa-gavel"></i><input type="number" name="system.dr.bludgeoning" value="{{srcDr.bludgeoning}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.bludgeoning}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Fire"}}"><i class="fa-solid fa-fire"></i><input type="number" name="system.dr.heat" value="{{srcDr.heat}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.heat}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Cold"}}"><i class="fa-solid fa-snowflake"></i><input type="number" name="system.dr.cold" value="{{srcDr.cold}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.cold}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Lightning"}}"><i class="fa-solid fa-bolt"></i><input type="number" name="system.dr.electric" value="{{srcDr.electric}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.electric}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Thunder"}}"><i class="fa-solid fa-volume-high"></i><input type="number" name="system.dr.sonic" value="{{srcDr.sonic}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.sonic}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Radiant"}}"><i class="fa-solid fa-sun"></i><input type="number" name="system.dr.radiant" value="{{srcDr.radiant}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.radiant}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Necrotic"}}"><i class="fa-solid fa-skull"></i><input type="number" name="system.dr.necrotic" value="{{srcDr.necrotic}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.necrotic}}</small></div>
      <div title="{{localize "DEDREL.ItemFields.Acid"}}"><i class="fa-solid fa-flask"></i><input type="number" name="system.dr.acid" value="{{srcDr.acid}}" style="width:32px;"/><small style="opacity:.6;">/{{effDr.acid}}</small></div>
    </div>
  </section>

  {{!-- Магия: техники и доктрины (для кастеров) --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.Npc.Magic"}}</div>

    <div style="font-size:12px; opacity:.8; margin-bottom:2px;">{{localize "DEDREL.Npc.Techniques"}}</div>
    <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:4px; margin-bottom:8px;">
      {{#each srcTechniques as |tech|}}
        <div style="display:flex; align-items:center; gap:3px;">
          <label style="flex:1; font-size:11px;">{{localize tech.label}}</label>
          <input type="number" name="system.magic.techniques.{{tech.key}}" value="{{tech.value}}" style="width:34px;"/>
        </div>
      {{/each}}
    </div>

    <div style="font-size:12px; opacity:.8; margin-bottom:2px;">{{localize "DEDREL.Npc.Doctrines"}} <span style="opacity:.6;">({{localize "DEDREL.Npc.Rank"}} / {{localize "DEDREL.Npc.Unlocked"}})</span></div>
    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:2px 10px;">
      {{#each doctrines as |doc|}}
        <div style="display:flex; align-items:center; gap:4px;">
          <label style="flex:1; font-size:11px;">{{localize doc.label}}</label>
          <input type="number" name="system.doctrines.{{doc.key}}.rank" value="{{doc.rank}}" title="{{localize "DEDREL.Npc.Rank"}}" style="width:34px;"/>
          <input type="number" name="system.doctrines.{{doc.key}}.unlocked" value="{{doc.unlocked}}" title="{{localize "DEDREL.Npc.Unlocked"}}" style="width:34px;"/>
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- Способности (обычные Item'ы) --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.Npc.Abilities"}}</div>
    <div style="font-size:11px; opacity:.6; margin-bottom:4px;">{{localize "DEDREL.Npc.DropHint"}}</div>
    {{#each groups.ability as |item|}}
      <div class="npc-item-row" data-item-id="{{item.id}}" style="display:flex; align-items:center; gap:6px; padding:2px 0;">
        <img src="{{item.img}}" style="width:22px; height:22px; object-fit:cover;"/>
        <span style="flex:1;">{{item.name}}</span>
        {{#if item.apCost}}<span style="font-size:11px; opacity:.7;">{{item.apCost}} AP</span>{{/if}}
        <a data-action="useItem" title="{{localize "DEDREL.Npc.Use"}}"><i class="fa-solid fa-play"></i></a>
        <a data-action="editItem"><i class="fa-solid fa-edit"></i></a>
        <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
  </section>

  {{!-- Экипировка (оружие/броня) --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.Npc.Equipment"}}</div>
    {{#each groups.weapon as |item|}}
      <div class="npc-item-row" data-item-id="{{item.id}}" style="display:flex; align-items:center; gap:6px; padding:2px 0;">
        <img src="{{item.img}}" style="width:22px; height:22px; object-fit:cover;"/>
        <span style="flex:1;">{{item.name}}</span>
        <a data-action="useItem" title="{{localize "DEDREL.Npc.Use"}}"><i class="fa-solid fa-play"></i></a>
        <a data-action="editItem"><i class="fa-solid fa-edit"></i></a>
        <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
    {{#each groups.armor as |item|}}
      <div class="npc-item-row" data-item-id="{{item.id}}" style="display:flex; align-items:center; gap:6px; padding:2px 0;">
        <img src="{{item.img}}" style="width:22px; height:22px; object-fit:cover;"/>
        <span style="flex:1;">{{item.name}}</span>
        <a data-action="editItem"><i class="fa-solid fa-edit"></i></a>
        <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
    {{#each groups.other as |item|}}
      <div class="npc-item-row" data-item-id="{{item.id}}" style="display:flex; align-items:center; gap:6px; padding:2px 0;">
        <img src="{{item.img}}" style="width:22px; height:22px; object-fit:cover;"/>
        <span style="flex:1;">{{item.name}}</span>
        <a data-action="editItem"><i class="fa-solid fa-edit"></i></a>
        <a data-action="deleteItem"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
  </section>

  {{!-- Описание --}}
  <section>
    <div style="font-weight:bold; margin-bottom:4px;">{{localize "DEDREL.ActorSheet.BiographyAndDescription"}}</div>
    <textarea name="system.details.biography" rows="4" style="width:100%;">{{system.details.biography}}</textarea>
  </section>

</div>
