<form class="dedrel-roll-dialog">
    {{#unless isSave}}
    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SpecializationBonus"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="specialization" />
        </div>
    </div>
    {{/unless}}
    
    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SituationalBonus"}}</label>
        <div class="form-fields">
            <select name="bonus">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SituationalPenalty"}}</label>
        <div class="form-fields">
            <select name="penalty">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
        </div>
    </div>

    <hr>
    
    <div class="talents-info">
        <h4>{{localize "DEDREL.Dice.ApplicableTalents"}}</h4>
        <div class="situational-talents-list">
            {{#if situationalTalents.length}}
                {{#each situationalTalents}}
                <div style="margin-bottom: 5px;">
                    <ul style="margin: 0; padding-left: 20px; text-align: left; word-wrap: break-word; white-space: normal;">
                        <li style="white-space: normal; line-height: 1.3;"><b>{{this.name}}</b>: <span style="font-size: 0.9em; font-style: italic; white-space: normal;">{{this.description}}</span></li>
                    </ul>
                </div>
                {{/each}}
            {{else}}
                <span style="color: #666; font-style: italic;">{{localize "DEDREL.Dice.TalentsHint"}}</span>
            {{/if}}
        </div>
    </div>
</form>
