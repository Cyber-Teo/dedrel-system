<form class="dedrel-roll-dialog">
    {{#unless isSave}}
    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SpecializationBonus"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="specialization" />
        </div>
    </div>
    {{/unless}}
    
    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SituationalBonus"}}</label>
        <div class="form-fields">
            <input type="number" name="bonus" value="0" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DEDREL.Dice.SituationalPenalty"}}</label>
        <div class="form-fields">
            <input type="number" name="penalty" value="0" />
        </div>
    </div>

    <hr>
    
    <div class="talents-info">
        <h4>{{localize "DEDREL.Dice.ApplicableTalents"}}</h4>
        <div class="situational-talents-list">
            {{#if situationalTalents.length}}
                {{#each situationalTalents}}
                <div class="form-group" style="margin-bottom: 5px;">
                    <label style="display: flex; align-items: center; justify-content: flex-start; gap: 10px; cursor: pointer; font-weight: normal;">
                        <input type="checkbox" class="situational-talent-cb" data-bonus="{{this.bonus}}" style="flex: 0 0 auto;" /> 
                        <span><b>{{this.name}}</b> ({{this.trigger}}: +{{this.bonus}})</span>
                    </label>
                </div>
                {{/each}}
            {{else}}
                <span style="color: #666; font-style: italic;">{{localize "DEDREL.Dice.TalentsHint"}}</span>
            {{/if}}
        </div>
    </div>
</form>
