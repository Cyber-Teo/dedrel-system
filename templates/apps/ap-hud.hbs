{{#if visible}}
<div class="ap-hud-container">

  <div class="ap-resources">
    {{#if maneuver.length}}
    <div class="ap-row maneuver">
      <div class="ap-label">MAN</div>
      <div class="ap-cubes">
        {{#each maneuver}}
        <div class="ap-cube {{#if this.active}}active{{/if}}"></div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if universal.length}}
    <div class="ap-row universal">
      <div class="ap-label">UNI</div>
      <div class="ap-cubes">
        {{#each universal}}
        <div class="ap-cube {{#if this.active}}active{{/if}}"></div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if magic.length}}
    <div class="ap-row magic">
      <div class="ap-label">MAG</div>
      <div class="ap-cubes">
        {{#each magic}}
        <div class="ap-cube {{#if this.active}}active{{/if}}"></div>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div>

  {{#if hasStatusRow}}
  <div class="ap-status">
    {{#if showAction}}
    <div class="ap-row action">
      <div class="ap-label">ACT</div>
      <div class="ap-action-state {{#if actionSpent}}spent{{else}}ready{{/if}}"
        title="{{localize "DEDREL.Hud.ActionHint"}}">
        {{#if actionSpent}}{{localize "DEDREL.Hud.ActionSpent"}}{{else}}{{localize "DEDREL.Hud.ActionReady"}}{{/if}}
      </div>
    </div>
    {{/if}}

    {{#if hasSpeed}}
    <div class="ap-row speed">
      <div class="ap-label">SPD</div>
      <div class="ap-speed-bar">
        <div class="ap-speed-fill" style="width: {{speedPercent}}%;"></div>
        <span class="ap-speed-text">{{speedVal}} / {{speedMax}} м</span>
      </div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  <div class="ap-menus">
    <div class="ap-menu">
      <button type="button" class="ap-menu-btn" data-action="toggleMenu" data-menu="skills">
        {{localize "DEDREL.Hud.MenuSkills"}}
      </button>
      <div class="ap-menu-panel" data-menu="skills">
        {{#each favSkills as |skill|}}
        <a class="ap-menu-item rollable" data-action="hudRollCheck" data-skill="{{skill.key}}"
          data-rank="{{skill.rank}}" data-label="{{skill.name}}">
          <span class="ap-menu-name">{{skill.name}}</span>
          <span class="ap-menu-rank" title="{{localize "DEDREL.ActorSheet.Rank"}}">{{skill.rank}}</span>
          <span class="ap-menu-bonus" title="BONUS">{{numberFormat skill.bonus sign=true}}</span>
        </a>
        {{else}}
        <div class="ap-menu-empty">{{localize "DEDREL.Hud.MenuEmpty"}}</div>
        {{/each}}
      </div>
    </div>

    <div class="ap-menu">
      <button type="button" class="ap-menu-btn" data-action="toggleMenu" data-menu="abilities">
        {{localize "DEDREL.Hud.MenuAbilities"}}
      </button>
      <div class="ap-menu-panel" data-menu="abilities">
        {{#each favAbilities as |item|}}
        <a class="ap-menu-item rollable" data-action="hudUseItem" data-item-id="{{item.id}}">
          <span class="ap-menu-name">{{item.name}}</span>
          {{#if item.hasCharges}}<span class="ap-menu-charges">{{item.uses}}/{{item.max}}</span>{{/if}}
        </a>
        {{else}}
        <div class="ap-menu-empty">{{localize "DEDREL.Hud.MenuEmpty"}}</div>
        {{/each}}
      </div>
    </div>

    <div class="ap-menu">
      <button type="button" class="ap-menu-btn" data-action="toggleMenu" data-menu="slots">
        {{localize "DEDREL.Hud.MenuSlots"}}
      </button>
      <div class="ap-menu-panel" data-menu="slots">
        {{#each quickSlots as |item|}}
        <a class="ap-menu-item rollable" data-action="hudUseItem" data-item-id="{{item.id}}">
          <span class="ap-menu-name">{{item.name}}</span>
          {{#if item.hasCharges}}<span class="ap-menu-charges">{{item.uses}}/{{item.max}}</span>{{/if}}
        </a>
        {{else}}
        <div class="ap-menu-empty">{{localize "DEDREL.Hud.MenuEmpty"}}</div>
        {{/each}}
      </div>
    </div>
  </div>

</div>
{{/if}}
