node_modules/

# Compendium databases are built from the JSON in packs/_source/ (npm run build-packs).
# Only the sources are tracked; packs/.sync-state.json is local sync bookkeeping.
packs/*
!packs/_source/

# World atlas (atlas/): build output, generated tiles and the local master-mode store.
atlas/node_modules/
atlas/dist/
atlas/public/tiles/
atlas/api/_data/
