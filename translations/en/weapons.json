  "matriarch_goat_horns": {
    "_src": "a22725cd78",
    "name": "Goat Horns",
    "system.description": "<p><strong>The Matriarch's second head.</strong> Step IV, bludgeoning: her only weapon that can perform Ram.</p><p><strong>Control Zone 2</strong>: it also carries the creature's size-based Control. The system reads CZ from the equipped melee weapon; the actor has no separate size field.</p>"
  },
  "matriarch_lion_maw": {
    "_src": "bb51ce167a",
    "name": "Lion Maw",
    "system.description": "<p><strong>The Matriarch's first head.</strong> Step IV. The main head: if a player doesn't declare where they're striking, the damage is recorded against it.</p><p><strong>Control Zone 2</strong>: it also carries the creature's size-based Control. The system reads CZ from the equipped melee weapon; the actor has no separate size field.</p>"
  },
  "matriarch_serpent_head": {
    "_src": "b559a595de",
    "name": "Serpent Head",
    "system.description": "<p><strong>The Matriarch's third head</strong>: a tail ending in a snake. Step III: it hits weaker than the other two but carries a venom that neither DR nor resistance reduces.</p><p><strong>Control Zone 2</strong>: it also carries the creature's size-based Control. The system reads CZ from the equipped melee weapon; the actor has no separate size field.</p>"
  },
